POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=taskmanager
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://taskmanager:devpassword@postgres:5432/taskmanager

# Local development only. HTTPS deployments require true and HTTPS origins.
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
AUTH_RATE_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
RECOVERY_RATE_LIMIT=3

# Real reset email delivery: configure a verified sender with your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10
PUBLIC_FRONTEND_URL=http://localhost:5173
RESET_TOKEN_TTL_MINUTES=30
